# === Groq (Primary: Whisper transcription + LLM summaries) ===
GROQ_API_KEY=gsk_your_groq_key_here
# GROQ_API_KEY_1=gsk_backup_key

# === Deepgram (Fallback: Nova-2 transcription) ===
# DEEPGRAM_API_KEY=your_deepgram_key
# DEEPGRAM_API_KEY_1=backup_deepgram_key

# === Supabase (Auth + note storage — optional) ===
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key

# === Server Config ===
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
REQUIRE_AUTH=false
MAX_REQUESTS_PER_MINUTE=15
METRICS_TOKEN=change-this-in-production
FREE_TRANSCRIPTIONS_LIMIT=5

# === Client (Vite picks up VITE_ prefixed vars) ===
VITE_TRANSCRIPTION_API_URL=http://localhost:8787
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
